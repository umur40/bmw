<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Detaylı BMI & Sağlık Skoru Hesaplayıcı</title>
  <style>
    :root {
      --primary-color: #4285f4;
      --danger-color: #ea4335;
      --warning-color: #fbbc05;
      --success-color: #34a853;
      --light-gray: #f5f5f5;
      --dark-gray: #333;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--light-gray);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      color: var(--dark-gray);
    }

    .container {
      background-color: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      text-align: center;
      width: 90%;
      max-width: 550px;
    }

    h1 {
      color: var(--primary-color);
      margin-bottom: 25px;
    }

    .input-group {
      margin-bottom: 20px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
    }

    input, select {
      width: 100%;
      padding: 12px 15px;
      border-radius: 8px;
      border: 1px solid #ddd;
      font-size: 16px;
      box-sizing: border-box;
    }

    button {
      width: 100%;
      padding: 14px;
      border-radius: 8px;
      border: none;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      background-color: var(--primary-color);
      color: white;
    }

    #result {
      margin-top: 30px;
      padding: 20px;
      border-radius: 8px;
      font-size: 18px;
      display: none;
    }

    .health-score {
      font-size: 24px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>BMI & Sağlık Skoru Hesaplayıcı</h1>

    <div class="input-group">
      <label for="height">Boy (cm):</label>
      <input type="number" id="height" placeholder="Örnek: 175" min="100" max="250" step="0.1" />
    </div>

    <div class="input-group">
      <label for="weight">Kilo (kg):</label>
      <input type="number" id="weight" placeholder="Örnek: 70" min="30" max="300" step="0.1" />
    </div>

    <div class="input-group">
      <label for="heartRate">Dinlenme Kalp Atışı (bpm):</label>
      <input type="number" id="heartRate" placeholder="Örnek: 70" min="40" max="110" step="1" />
    </div>

    <div class="input-group">
      <label for="activityLevel">Aktivite Seviyesi:</label>
      <select id="activityLevel">
        <option value="1.2">Sedanter (Az aktivite)</option>
        <option value="1.4">Hafif aktif</option>
        <option value="1.6">Orta düzeyde aktif</option>
        <option value="1.8">Çok aktif</option>
      </select>
    </div>

    <button onclick="calculateHealthScore()">Sağlık Skoru Hesapla</button>

    <div id="result">
      <h2>Sağlık Skorunuz</h2>
      <div class="health-score" id="health-score">0</div>
    </div>
  </div>

  <script>
    function calculateHealthScore() {
      const height = parseFloat(document.getElementById("height").value) / 100;
      const weight = parseFloat(document.getElementById("weight").value);
      const heartRate = parseFloat(document.getElementById("heartRate").value);
      const activityMultiplier = parseFloat(document.getElementById("activityLevel").value);
      
      if (!height || !weight || !heartRate) {
        alert("Lütfen tüm bilgileri doğru girin.");
        return;
      }

      const bmi = weight / (height * height);
      const fitnessFactor = (60 / heartRate) * activityMultiplier;

      const healthScore = Math.min(100, (bmi * 10) + (fitnessFactor * 20));

      document.getElementById("health-score").textContent = healthScore.toFixed(1);
      document.getElementById("result").style.display = "block";
    }
  </script>
</body>
</html>
